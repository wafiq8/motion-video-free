{
  "fps": 30,
  "variant": "BERITA",
  "mode": "D",
  "audio_duration_s": 77.01,
  "total_duration_s": 77.48,
  "sentences": [
    {
      "id": 1,
      "text": "Seorang mantan Kapolri, kini jadi tersangka makar terhadap presiden yang pernah ia layani.",
      "start_s": 0.0,
      "end_s": 5.66,
      "scene": 1
    },
    {
      "id": 2,
      "text": "Senin malam, Bareskrim Polri menetapkan enam tersangka: Jenderal Purnawirawan Listyo Sigit Prabowo dan lima perwira aktif.",
      "start_s": 5.94,
      "end_s": 13.82,
      "scene": 2
    },
    {
      "id": 3,
      "text": "Kasusnya pengembangan dari skandal penyadapan ilegal terhadap Presiden Prabowo.",
      "start_s": 13.92,
      "end_s": 18.74,
      "scene": 3
    },
    {
      "id": 4,
      "text": "Versi penyidik, rencananya berjalan tiga tahap.",
      "start_s": 18.96,
      "end_s": 22.08,
      "scene": 4
    },
    {
      "id": 5,
      "text": "Tahap satu: rapat pemufakatan 3 Oktober 2024, sebelum presiden terpilih dilantik — ditemukan dokumen analisis politik sampai analisis pemakzulan.",
      "start_s": 22.14,
      "end_s": 32.14,
      "scene": 4
    },
    {
      "id": 6,
      "text": "Tahap dua: penyadapan tokoh-tokoh yang dipetakan.",
      "start_s": 32.34,
      "end_s": 35.42,
      "scene": 4
    },
    {
      "id": 7,
      "text": "Tahap tiga: permulaan pelaksanaan.",
      "start_s": 35.64,
      "end_s": 38.2,
      "scene": 4
    },
    {
      "id": 8,
      "text": "Motifnya, kata Kabareskrim, mempertahankan jabatan Kapolri demi konstelasi politik, dengan melemahkan kepercayaan publik pada pemerintah.",
      "start_s": 38.34,
      "end_s": 46.5,
      "scene": 5
    },
    {
      "id": 9,
      "text": "Para tersangka dijerat pasal makar: ancamannya pidana mati, penjara seumur hidup, atau 20 tahun penjara.",
      "start_s": 46.58,
      "end_s": 53.76,
      "scene": 6
    },
    {
      "id": 10,
      "text": "Penyidik memeriksa 71 saksi dan menyita uang tunai 735 juta rupiah.",
      "start_s": 53.92,
      "end_s": 60.2,
      "scene": 7
    },
    {
      "id": 11,
      "text": "Tapi ingat: semua ini masih dugaan.",
      "start_s": 60.24,
      "end_s": 63.2,
      "scene": 8
    },
    {
      "id": 12,
      "text": "Belum ada putusan pengadilan, dan para tersangka berhak atas praduga tak bersalah.",
      "start_s": 63.2,
      "end_s": 68.08,
      "scene": 8
    },
    {
      "id": 13,
      "text": "Pertanyaannya: kalau tuduhan seberat ini diarahkan ke mantan pimpinan polisi tertinggi — apa yang sebenarnya terjadi di dalam institusi itu?",
      "start_s": 68.3,
      "end_s": 76.58,
      "scene": 9
    }
  ],
